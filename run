#! /usr/bin/env python3
# PYTHON_ARGCOMPLETE_OK

# Imports
import os
import sys
import shlex
import shutil
import tomllib
import argparse
import argcomplete
import subprocess

# Constants
SCRIPT_FILE = __file__
SCRIPT_DIR = os.path.dirname(__file__)
SCRIPT_DIR = os.path.normpath(SCRIPT_DIR)


def eprint(*args, **kwargs):
  kwargs['file'] = sys.stderr
  print(*args, **kwargs)


def load_targets() -> dict:
  with open('run-config.toml', 'rb') as fp:
    cfg = tomllib.load(fp)

  targets = cfg.get('targets')
  if not targets:
    eprint('Error: Config has no targets.')
    sys.exit(1)

  variables = cfg.copy()
  variables.pop('targets')

  for key, value in variables.items():
    for skey, svalue in variables.items():
      value = value.replace('{' + skey + '}', svalue)
    variables[key] = value

  for target, commands in targets.items():
    if not commands:
      eprint(f"Error: Target '{target}' is empty.")
      sys.exit(1)
    for i, cmd in enumerate(commands):
      isolate = cmd.startswith('[') and cmd.endswith(']')
      if isolate:
        cmd = cmd.removeprefix('[').removesuffix(']')
      for key, value in variables.items():
        cmd = cmd.replace('{' + key + '}', value)
      cmd = shlex.split(cmd)
      if len(cmd) < 1:
        eprint(f"Error: Target '{target}' has empty command.")
        sys.exit(1)
      exe = cmd[0]
      if not isolate and not shutil.which(exe):
        eprint(f"Error: Program '{exe}' not installed.")
        sys.exit(1)
      commands[i] = (isolate, cmd)
    targets[target] = commands

  return targets


def main():
  targets = load_targets()
  target_names = list(targets)

  parser = argparse.ArgumentParser()
  parser.add_argument(
    'target', choices=target_names,
    default=target_names[0],
    const=target_names[0],
    nargs='?',
  )

  argcomplete.autocomplete(parser)
  args = parser.parse_args()
  commands = targets[args.target]

  for isolate, args in commands:
    print(' '.join(args))
    if isolate:
      try:
        subprocess.run(args, cwd=SCRIPT_DIR)
      except KeyboardInterrupt:
        print()
    else:
      proc = subprocess.run(
        args,
        cwd=SCRIPT_DIR,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
      )
      exit_code = proc.returncode
      if exit_code != getattr(os, 'EX_OK', 0):
        print(f'\nCommand failed with code {exit_code}:')
        print(proc.stdout.decode())
        sys.exit(1)


if __name__ == '__main__':
  sys.exit(main())
