using Gtk 4.0;
using Adw 1;

template $ResultDialog: Adw.Dialog {
  content-width: 420;
  name: "result-dialog";

  Adw.ToolbarView {

    [top]
    Adw.HeaderBar {}
    content: ScrolledWindow {
      propagate-natural-height: true;
      max-content-height: 620;

      Adw.Clamp {
        maximum-size: 375;

        Box {
          margin-top: 6;
          margin-bottom: 6;
          margin-start: 12;
          margin-end: 12;
          orientation: vertical;
          spacing: 16;

          Adw.PreferencesGroup {
            title: _("Result");

            Box {
              styles ["card"]
              name: "result-box";
              orientation: vertical;

              Label result_label {
                styles ["title-1"]
                name: "result-label";
                selectable: true;
              }

              Label feedback_label {
                styles ["heading"]
                name: "feedback-label";
              }
            }
          }

          Adw.PreferencesGroup thresholds_group {
            title: _("Thresholds");
            margin-bottom: 10;
            visible: false;
          }

          Adw.PreferencesGroup context_group {
            title: _("Additional context");
            margin-bottom: 10;
            visible: false;
          }
        }
      }
    };
  }
}
