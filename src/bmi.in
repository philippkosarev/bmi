#!@PYTHON@

import os
import sys
import signal
import locale
import gettext

LOCALE_DIR = '@localedir@'
PKG_DATA_DIR = '@pkgdatadir@'
RESOURCE_FILE = os.path.join(PKG_DATA_DIR, 'bmi.gresource')

sys.path.insert(1, PKG_DATA_DIR)
signal.signal(signal.SIGINT, signal.SIG_DFL)

locale.bindtextdomain('bmi', LOCALE_DIR)
locale.textdomain('bmi')
gettext.install('bmi', LOCALE_DIR)

if __name__ == '__main__':
  from gi.repository import Gio
  resource = Gio.Resource.load(RESOURCE_FILE)
  resource._register()

  from bmi.main import main
  sys.exit(main())
