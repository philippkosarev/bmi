using Gtk 4.0;
using Adw 1;

template $BmiWindow: Adw.ApplicationWindow {
  title: "BMI";
  height-request: 440;

  Adw.Breakpoint {
    condition ("min-width: 450pt")
    setters {
      main_box.orientation: horizontal;
      main_clamp.maximum-size: 520;
      main_clamp.tightening-threshold: 300;
      main_box.margin-bottom: 0;
      main_box.homogeneous: true;
    }
  }

  [content]
  Adw.ToolbarView {

    [top]
    Adw.HeaderBar {

      [end]
      MenuButton {
        icon-name: "open-menu-symbolic";
        menu-model: primary_menu;
        primary: true;
      }
    }

    content: Adw.ToastOverlay toast_overlay {

      ScrolledWindow {
        hscrollbar-policy: never;

        Adw.Clamp main_clamp {
          unit: pt;
          maximum-size: 270;
          tightening-threshold: 200;

          Box main_box {
            styles ["main-box"]
            orientation: vertical;
            margin-bottom: 70;

            Adw.PreferencesGroup {
              hexpand: true;

              $SpinRow height_input_row {
                title: _("Height");
                tooltip-text: _("Affects BMI and BRI");
                lower: 10;
                upper: 999;
              }

              $SpinRow weight_input_row {
                title: _("Weight");
                tooltip-text: _("Affects BMI");
                lower: 10;
                upper: 999;
              }

              $DropDownRow gender_input_row {
                title: _("Gender");
                subtitle: _("Biological gender");
                tooltip-text: _("Affects healthy/unhealthy thresholds for Waist to Hip ratio");
                model: StringList {
                  strings [_("Average"), _("Female"), _("Male")]
                };
              }

              $SpinRow age_input_row {
                title: _("Age");
                subtitle: _("Years");
                tooltip-text: _("Affects healthy/unhealthy thresholds for Waist to Height ratio");
                digits: 0;
                lower: 18;
                upper: 150;
              }

              $SpinRow waist_input_row {
                title: _("Waist");
                tooltip-text: _("Affects Waist to Height ratio, Waist to Hip ratio and BRI");
                lower: 10;
                upper: 999;
              }

              $SpinRow hip_input_row {
                title: _("Hip");
                tooltip-text: _("Affects Waist to Hip ratio");
                lower: 10;
                upper: 999;
              }
            }

            Adw.PreferencesGroup {
              hexpand: true;

              $ResultRow bmi_result_row {
                title: _("BMI");
                tooltip-text: _("Body Mass Index");
                digits: 2;
                context-description: _("With the same height, this is what weight you would need to achieve different BMI thresholds.");
              }

              $ResultRow bri_result_row {
                title: _("BRI");
                tooltip-text: _("Body Roundness Index");
              }

              $ResultRow whr_result_row {
                title: _("WHR");
                tooltip-text: _("Waist to hip ratio");
              }

              $ResultRow whtr_result_row {
                title: _("WHtR");
                tooltip-text: _("Waist to height ratio");
              }
            }
          }
        }
      }
    };
  }
}

menu primary_menu {
  item {
    label: _("Preferences");
    action: "app.preferences";
  }
  item {
    label: _("About BMI");
    action: "app.about";
  }
}
