using Gtk 4.0;
using Adw 1;

template $BmiPreferences: Adw.PreferencesDialog {
  content-width: 380;
  content-height: 250;

  Adw.PreferencesPage {
    title: _("Preferences");

    $Group {

      $DropDownRow {
        key: "measurement-system";
        icon-name: "ruler-angled-symbolic";
        title: _("Units");
        subtitle: _("Measurement system");
        model: StringList {
          strings [_("Metric"), _("Imperial")]
        };
      }

      $SwitchRow {
        key: "remember-inputs";
        icon-name: "user-bookmarks-symbolic";
        title: _("Remember inputs");
        subtitle: _("Restore inputs from last session");
      }
    }
  }
}
